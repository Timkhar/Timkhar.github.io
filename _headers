# Hand-written (not generated by build:sample). Read by Netlify and Cloudflare Pages when
# apps/web/out is uploaded; ignored by the local static server. Plain hardening, no CSP: a
# static export cannot use nonces and the pages carry Next.js inline bootstrap scripts.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
